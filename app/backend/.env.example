NODE_ENV=development
PORT=4000

# --- Supabase (Postgres) ---
# Copia la cadena desde: Supabase → Project Settings → Database → Connection string → URI.
# Usa el "Session pooler" (puerto 5432, no el 6543 de transacción): el host de conexión
# directa (db.TU_PROJECT_REF.supabase.co) solo resuelve por IPv6, y muchas redes/ISP
# locales no tienen salida IPv6, lo que da error ENOTFOUND. El pooler resuelve por IPv4.
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres
DB_SSL=true

# --- Alternativa: Postgres local vía Docker ---
# Solo si NO usas DATABASE_URL. Requiere levantar el servicio opcional:
#   docker compose --profile local-db up -d postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=app_delivery
# DB_USER=user_delivery
# DB_PASSWORD=pass_delivery
# DB_SSL=false

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
